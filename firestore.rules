rules_version = '2';

// Torneo de clases
// - Cualquiera (sin sesión) puede ver los torneos.
// - Solo las cuentas en admins/{uid} pueden crear o modificar torneos.
// - La primera cuenta que inicia sesión queda como cuenta principal (meta/owner)
//   y es la única que puede dar o quitar permisos de admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownerPath() {
      return /databases/$(database)/documents/meta/owner;
    }

    function isOwner() {
      return signedIn()
        && exists(ownerPath())
        && get(ownerPath()).data.uid == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /meta/owner {
      allow read: if true;
      // Solo se puede crear una vez (create no aplica a documentos existentes),
      // y en el mismo lote que el admins/{uid} de quien la crea.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if isOwner()
        || (uid == request.auth.uid
            && !exists(ownerPath())
            && getAfter(ownerPath()).data.uid == uid);
      // La cuenta principal no se puede quitar a sí misma.
      allow delete: if isOwner() && uid != request.auth.uid;
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'provider', 'lastLoginAt']);
      allow delete: if false;
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Inscripción de una cuenta en el torneo (una por cuenta: el id del documento es su uid).
      match /requests/{uid} {
        function isDraft() {
          return get(/databases/$(database)/documents/tournaments/$(tid)).data.status == 'draft';
        }

        // Respaldo del filtro de vulgaridades de la app (palabras completas, en minúsculas).
        function clean(s) {
          return !s.lower().matches('(.*[^a-z])?(puta|puto|putas|putos|mierda|verga|vergas|pendej[a-z]*|ching[a-z]*|culer[a-z]*|culo|cabron[a-z]*|joto|maricon|marica|pinche|fuck[a-z]*|shit[a-z]*|bitch[a-z]*|ass|asshole|dick|cunt|whore|slut)([^a-z].*)?');
        }

        function validOwnRequest() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'photoURL', 'type', 'teamId', 'newTeam', 'status',
                                   'createdAt', 'updatedAt', 'decidedBy', 'decidedAt'])
            && d.uid == uid
            && d.status == 'pending'
            && d.decidedBy == null
            && d.decidedAt == null
            // Queda a nombre de la cuenta: el mismo nombre de su perfil.
            && d.name == get(/databases/$(database)/documents/users/$(uid)).data.name
            && d.photoURL is string && d.photoURL.size() < 1000
            && d.createdAt is int && d.updatedAt is int
            && ((d.type == 'join' && d.teamId is string && d.newTeam == null)
                || (d.type == 'create' && d.teamId == null
                    && d.newTeam.keys().hasOnly(['name', 'color'])
                    && d.newTeam.name is string
                    && d.newTeam.name.size() > 0 && d.newTeam.name.size() <= 24
                    && d.newTeam.color is string && d.newTeam.color.matches('#[0-9a-fA-F]{6}')
                    && clean(d.newTeam.name)));
        }

        // Las aprobadas son públicas (integrantes de cada equipo); las demás solo las ve su dueño y los admins.
        allow get: if (signedIn() && request.auth.uid == uid) || resource.data.status == 'approved' || isAdmin();
        allow list: if resource.data.status == 'approved' || isAdmin();
        // La cuenta crea o cambia su propia solicitud mientras el torneo está en preparación.
        allow create, update: if signedIn() && request.auth.uid == uid && isDraft() && validOwnRequest();
        // Los admins aprueban o rechazan dejando constancia de quién decidió.
        allow update: if isAdmin()
          && request.resource.data.decidedBy.uid == request.auth.uid
          && request.resource.data.status in ['approved', 'rejected'];
        // La cuenta cancela o sale del equipo mientras está en preparación; un admin siempre puede borrarla.
        allow delete: if (signedIn() && request.auth.uid == uid && isDraft()) || isAdmin();
      }
    }
  }
}
